# Copy this file to .env and add your Groq key when you have it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional. Enables cited searches of trusted medical reference websites when the catalogue has no useful information.
TAVILY_API_KEY=
PORT=3000
# Optional path for the local SQLite database.
# DB_PATH=./data/medibot.sqlite
